{
  "name": "bobslab",
  "private": true,
  "author": {
    "name": "Godswill Ezeala",
    "url": "https://bobthebuilder.tech"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint --",
    "lint:fix": "turbo lint:fix --",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo check-types",
    "skills": "pnpm --filter @bobslab/ai-skills run dev",
    "ai-skills": "pnpm --filter @bobslab/ai-skills run dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.8.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "patchedDependencies": {
      "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs.patch"
    }
  }
}
