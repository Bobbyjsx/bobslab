{
  "name": "bobslab",
  "private": true,
  "author": {
    "name": "Godswill Ezeala",
    "url": "https://bobthebuilder.tech"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint:fix": "concurrently --names \"eslint,prettier\" --prefix-colors \"blue,magenta\" \"pnpm run lint:eslint:fix\" \"pnpm run format\"",
    "check-types": "turbo check-types",
    "bobslab": "pnpm --filter @bobslab/cli run dev",
    "bobs-lab": "pnpm --filter @bobslab/cli run dev",
    "skills": "pnpm --filter @bobslab/cli run dev skills",
    "cli": "pnpm --filter @bobslab/cli run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bobslab/config": "workspace:^",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.8.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "patchedDependencies": {
      "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs.patch"
    }
  }
}
