{
  "name": "@bobslab/ui",
  "version": "0.0.3",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/output.css": {
      "import": "./dist/output.css",
      "require": "./dist/output.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:style": "tailwindcss -i ./src/styles/input.css -o ./dist/output.css",
    "build": "tsup src/index.ts --format=esm,cjs --dts --clean --minify --sourcemap && pnpm build:style",
    "dev:style": "tailwindcss -i ./src/styles/input.css -o ./dist/output.css --watch",
    "dev": "concurrently \"tsup src/index.ts --format=esm,cjs --dts --watch\" \"pnpm dev:style\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0 || ^18.0.0",
    "react-dom": "^19.0.0 || ^18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bobslab/config": "workspace:*",
    "@bobslab/hooks": "workspace:*",
    "@bobslab/icons": "workspace:*",
    "@bobslab/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@bobslab/config": "workspace:*",
    "@tailwindcss/cli": "^4.0.9",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.7"
  },
  "license": "MIT",
  "author": {
    "name": "Godswill Ezeala",
    "url": "https://godswillezeala.online/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bobbyjsx/bobslab.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  }
}
