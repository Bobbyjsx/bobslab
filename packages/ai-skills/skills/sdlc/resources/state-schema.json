{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDLCWorkflowRun",
  "type": "object",
  "required": ["runId", "objective", "state", "mode", "createdAt", "updatedAt", "story", "approvals"],
  "properties": {
    "runId": { "type": "string" },
    "objective": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "INTAKE",
        "DISCOVERY",
        "AWAITING_PLAN_APPROVAL",
        "PLANNING_ONLY",
        "DECOMPOSITION",
        "IMPLEMENTATION",
        "TEST_AUTHORING",
        "QA",
        "TRIAGE",
        "BLOCKED",
        "AWAITING_HUMAN",
        "READY_FOR_HUMAN_REVIEW",
        "AWAITING_STORY_APPROVAL",
        "RELEASE",
        "STAGING_VERIFICATION",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "mode": { "type": "string", "enum": ["planning", "implementation"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "story": {
      "type": "object",
      "required": ["id", "title", "problemStatement", "desiredOutcome", "requirements", "acceptanceCriteria", "tasks"],
      "properties": {
        "id": { "type": "string" },
        "linearId": { "type": "string" },
        "title": { "type": "string" },
        "problemStatement": { "type": "string" },
        "desiredOutcome": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "assignedRole", "status", "retryCount", "maxRetries"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "assignedRole": { "type": "string" },
              "status": { "type": "string" },
              "retryCount": { "type": "number" },
              "maxRetries": { "type": "number" },
              "candidateSha": { "type": "string" },
              "prUrl": { "type": "string" }
            }
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "object",
          "required": ["approved", "timestamp", "approver"],
          "properties": {
            "approved": { "type": "boolean" },
            "timestamp": { "type": "string" },
            "approver": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "story": {
          "type": "object",
          "required": ["approved", "timestamp", "approver"],
          "properties": {
            "approved": { "type": "boolean" },
            "timestamp": { "type": "string" },
            "approver": { "type": "string" },
            "candidateSha": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
