{
  "name": "@bobslab/cli",
  "version": "0.0.1",
  "description": "The official Bobslab CLI for distributing AI agent skills and workspace toolchain configs",
  "type": "module",
  "bin": {
    "bobslab": "dist/cli.js",
    "bobs-lab": "dist/cli.js",
    "ai-skills": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "configs",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsup",
    "check-types": "pnpm exec tsc --noEmit",
    "link": "pnpm link --global",
    "link:test": "bobslab --help",
    "dev": "pnpm exec tsx src/cli.ts"
  },
  "author": {
    "name": "Godswill Ezeala",
    "url": "https://godswillezeala.online/"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@bobslab/config": "workspace:*",
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bobbyjsx/bobslab.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
